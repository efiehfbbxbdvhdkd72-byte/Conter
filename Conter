-- ==================== FUNCIÓN PARA HACER ARRASTRABLE ====================
local function hacerArrastrable(frame)
    local arrastrando = false
    local inputInicio
    local posicionInicio

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            arrastrando = true
            inputInicio = input.Position
            posicionInicio = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    arrastrando = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if arrastrando and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - inputInicio
            frame.Position = UDim2.new(posicionInicio.X.Scale, posicionInicio.X.Offset + delta.X, posicionInicio.Y.Scale, posicionInicio.Y.Offset + delta.Y)
        end
    end)
end

