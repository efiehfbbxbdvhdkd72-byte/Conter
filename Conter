    local nuevaVelocidad = tonumber(speedTextBox.Text)
    if nuevoObjetivo and nuevoObjetivo >= 0 then
        segundosObjetivo = nuevoObjetivo
    end
    if nuevaVelocidad and nuevaVelocidad > 0 then
        factorVelocidad = nuevaVelocidad
    else
        speedTextBox.Text = tostring(factorVelocidad)
    end
    aplicarTamano()
    if modoSubir then
        tiempoRestante = 0
    else
        tiempoRestante = segundosObjetivo
    end
    timerLabel.Text = formatearTiempo(tiempoRestante)
    estaPausado = true 
    actionButton.Text = "Play"
    actionButton.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
end)

applySizeButton.MouseButton1Click:Connect(function()
    aplicarTamano()
end)

-- ==================== HILO DEL TEMPORIZADOR ====================
-- Este hilo NO se detiene aunque ocultes el cuadrito, por eso el contador sigue
task.spawn(function()
    local ultimaEjecucion = tick()
    while temporizadorActivo and screenGui.Parent do
        task.wait()
        if not estaPausado then
            local tiempoActual = tick()
            local deltaTiempo = tiempoActual - ultimaEjecucion
            ultimaEjecucion = tiempoActual
            local avance = deltaTiempo * factorVelocidad
            if not modoSubir then
                tiempoRestante = tiempoRestante - avance
                if tiempoRestante <= 0 then
                    tiempoRestante = 0
                    timerLabel.Text = formatearTiempo(0)
                    estaPausado = true
                    actionButton.Text = "Play"
                    actionButton.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
                else
                    timerLabel.Text = formatearTiempo(tiempoRestante)
                end
            else
                tiempoRestante = tiempoRestante + avance
                if tiempoRestante >= segundosObjetivo then
                    tiempoRestante = segundosObjetivo
                    timerLabel.Text = formatearTiempo(segundosObjetivo)
                    estaPausado = true
                    actionButton.Text = "Play"
                    actionButton.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
                else
                    timerLabel.Text = formatearTiempo(tiempoRestante)
                end
            end
        else
            ultimaEjecucion = tick()
        end
    end
end)
