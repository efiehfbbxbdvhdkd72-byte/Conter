    menuButton.Text = "Abrir Menú"
    menuButton.BackgroundColor3 = Color3.fromRGB(50, 120, 255)
end

-- Reabre TODO (cuadrito + menú)
local function abrirTodo()
    mainFrame.Visible = true
    controlMenu.Visible = true
    floatButton.Visible = false
    menuButton.Text = "Cerrar Menú"
    menuButton.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
end

-- Solo abre/cierra el menú, sin ocultar el cuadrito
local function toggleSoloMenu()
    if controlMenu.Visible then
        controlMenu.Visible = false
        menuButton.Text = "Abrir Menú"
        menuButton.BackgroundColor3 = Color3.fromRGB(50, 120, 255)
    else
        controlMenu.Visible = true
        menuButton.Text = "Cerrar Menú"
        menuButton.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
    end
end

