-- ==================== FUNCIONES ====================
local function formatearTiempo(segundosTotales)
    local segundosRedondeados = math.floor(segundosTotales + 0.5)
    local horas = math.floor(segundosRedondeados / 3600)
    local minutos = math.floor((segundosRedondeados % 3600) / 60)
    local segundos = segundosRedondeados % 60
    return string.format("%02d:%02d:%02d", horas, minutos, segundos)
end

-- NUEVO: El cuadrito cambia de tamaño junto con el texto
local function aplicarTamano()
    local nuevoTamano = tonumber(sizeTextBox.Text)
    if nuevoTamano and nuevoTamano >= 8 and nuevoTamano <= 100 then
        timerLabel.TextSize = nuevoTamano

        -- Calculamos el tamaño del cuadrito según el tamaño del texto
        -- Texto chiquito = cuadrito chiquito, texto grande = cuadrito grande
        local anchoCuadro = math.clamp(nuevoTamano * 6.5 + 60, 140, 420)
        local altoTexto = nuevoTamano + 18
        local altoCuadro = altoTexto + 42 -- + espacio del botón "Abrir Menú"

        mainFrame.Size = UDim2.new(0, anchoCuadro, 0, altoCuadro)
        timerLabel.Size = UDim2.new(1, 0, 0, altoTexto)
        timerLabel.Position = UDim2.new(0, 0, 0, 4)

        -- El botón de Abrir Menú también se ajusta al nuevo tamaño
        local anchoBoton = anchoCuadro - 40
        menuButton.Size = UDim2.new(0, anchoBoton, 0, 28)
        menuButton.Position = UDim2.new(0.5, -anchoBoton/2, 0, altoTexto + 8)
    else
        sizeTextBox.Text = tostring(timerLabel.TextSize)
    end
end

tiempoRestante = segundosObjetivo
